# Rutas base del proyecto
# Se resuelven respecto al root del repo.
MODELS_DIR=./models
MEDIA_DIR=./media

# OCR compartido
OCR_HOST=0.0.0.0
OCR_DEFAULT_MODE=markdown
OCR_DEFAULT_BASE_SIZE=1024
OCR_DEFAULT_IMAGE_SIZE=768
OCR_DEFAULT_CROP_MODE=true
OCR_DEFAULT_MAX_NEW_TOKENS=8192

# Qwen TTS
QWEN_DEVICE=cuda:0
QWEN_DTYPE=bfloat16
QWEN_DEFAULT_LANGUAGE=Spanish
QWEN_DEFAULT_SPEAKER=Vivian
QWEN_TTS_MODEL=./models/qwen-tts-customvoice
QWEN_TTS_SAMPLE_RATE=24000
QWEN_HOST=0.0.0.0
QWEN_TTS_PORT=8002
QWEN_VOICE_RELOAD=true

# Qwen TTS Clone
QWEN_TTS_VOICE_CLONE_MODEL=./models/qwen-tts-model
QWEN_VOICE_CLONE_ENABLED=true
QWEN_VOICE_CLONE_XVECTOR_ONLY=true
QWEN_VOICE_CLONE_SPEAKER_NAME=MyVoice
QWEN_VOICE_CLONE_REF_AUDIO=./media/mi-voz.wav
QWEN_VOICE_CLONE_REF_TEXT=
QWEN_VOICE_CLONE_SERVICE_URL=http://localhost:8004
QWEN_TTS_CLONE_PORT=8004

# Qwen ASR
QWEN_ASR_MODEL=./models/qwen-asr-model
QWEN_ASR_HOST=0.0.0.0
QWEN_ASR_PORT=8003

# DeepSeek OCR 2
DEEPSEEK_OCR2_MODEL=./models/deepseek-ocr2
DEEPSEEK_OCR2_DEVICE=auto
DEEPSEEK_OCR2_DTYPE=
DEEPSEEK_OCR2_ATTN=
DEEPSEEK_OCR2_MODE=markdown
DEEPSEEK_OCR2_BASE_SIZE=1024
DEEPSEEK_OCR2_IMAGE_SIZE=768
DEEPSEEK_OCR2_CROP_MODE=true
DEEPSEEK_OCR2_HOST=0.0.0.0
DEEPSEEK_OCR2_PORT=8010

# GLM-OCR
GLM_OCR_MODEL=zai-org/GLM-OCR
GLM_OCR_DEVICE=auto
GLM_OCR_DTYPE=
GLM_OCR_ATTN=
GLM_OCR_MODE=markdown
GLM_OCR_BASE_SIZE=1024
GLM_OCR_IMAGE_SIZE=768
GLM_OCR_CROP_MODE=true
GLM_OCR_MAX_NEW_TOKENS=8192
GLM_OCR_HOST=0.0.0.0
GLM_OCR_PORT=8011

# OCR Gateway
OCR_GATEWAY_HOST=0.0.0.0
OCR_GATEWAY_PORT=8012
OCR_GATEWAY_TIMEOUT=180
OCR_DEEPSEEK_URL=http://localhost:8010
OCR_GLM_URL=http://localhost:8011
